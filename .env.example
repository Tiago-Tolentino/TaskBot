DISCORD_TOKEN=
CHANNEL_ID=

# Necessário para /ticket e npm run clickup:check
CLICKUP_API_TOKEN=
CLICKUP_TICKETS_LIST_ID=
CLICKUP_WORKSPACE_ID=

# Avisos automáticos (ative após configurar o canal)
TICKET_NOTIFICATIONS_ENABLED=false
TICKET_NOTIFICATION_CHANNEL_ID=
TICKET_NOTIFICATION_INTERVAL_SECONDS=600
# Mapeamento de IDs ClickUp -> Discord para menções e avisos privados
TICKET_NOTIFICATION_DISCORD_USER_MAP={}
# IDs do ClickUp permitidos no botão Escolher responsável, separados por vírgula
TICKET_ASSIGNMENT_ASSIGNEE_IDS=
# Privado para responsável vinculado no ticket novo ou ao atribuir pelo botão
TICKET_ASSIGNMENT_DM_ENABLED=false
# Privado com novas mensagens da Activity (requer webhook e vínculo ClickUp -> Discord)
TICKET_COMMENT_DM_ENABLED=false

# Webhook com túnel local iniciado automaticamente por npm start
CLICKUP_WEBHOOK_ENABLED=false
CLICKUP_WEBHOOK_PORT=3000
# Opcional: caminho do executável; padrão .tools/cloudflared ou cloudflared no PATH
CLOUDFLARED_PATH=
